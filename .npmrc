# node-linker=hoisted evita que pnpm arme node_modules con symlinks (su modo por
# defecto). Necesario en este repo porque puede vivir en filesystems sin soporte de
# symlinks (ej. FAT32/exFAT en pendrives). Si clonás esta plantilla a un disco normal
# (ext4/APFS/NTFS), podés borrar esta línea para volver al modo pnpm estándar.
node-linker=hoisted
